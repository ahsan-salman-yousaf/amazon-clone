# Copy to .env.local and fill in. Never commit real values.

# Neon Postgres (added via the Vercel Marketplace; copy from Vercel Storage -> .env.local tab).
# Pooled connection, used by the app at runtime (host contains "-pooler").
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Direct connection, used by drizzle-kit for migrations.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# Auth.js session encryption key. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-32-byte-base64-string"
