# Copy to .env.local and fill in. Never commit real values.

# Neon Postgres (added via the Vercel Marketplace; copy from Vercel Storage -> .env.local tab).
# Pooled connection, used by the app at runtime (host contains "-pooler").
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Direct connection, used by drizzle-kit for migrations.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# Auth.js session encryption key. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-32-byte-base64-string"

# Stripe TEST mode only (dashboard → Test mode → Developers → API keys). Live keys are refused.
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# Signing secret of the webhook endpoint https://<your-domain>/api/stripe/webhook
# (events: payment_intent.succeeded, payment_intent.payment_failed).
STRIPE_WEBHOOK_SECRET="whsec_..."
